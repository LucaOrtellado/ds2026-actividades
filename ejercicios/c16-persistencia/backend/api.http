@baseUrl = http://localhost:3000

### ==========================================
### LIBROS (5 Requests)
### ==========================================

### 1. Obtener todos los libros (o filtrar por género)
GET {{baseUrl}}/api/libros

### 2. Obtener un libro por ID (Éxito - 200)
GET {{baseUrl}}/api/libros/1

### 3. Obtener un libro inexistente (Error - 404)
GET {{baseUrl}}/api/libros/999

### 4. Crear un nuevo libro (Éxito - 201)
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Fahrenheit 451",
  "autor": "Ray Bradbury",
  "genero": "Ciencia ficción",
  "descripcion": "Una sociedad donde los libros están prohibidos.",
  "imagen": "https://covers.openlibrary.org/b/id/8231860-L.jpg"
}

### 5. Eliminar un libro inexistente (Error - 404)
DELETE {{baseUrl}}/api/libros/999


### ==========================================
### AUTORES (5 Requests)
### ==========================================

### 6. Obtener todos los autores (o filtrar por nacionalidad)
GET {{baseUrl}}/api/autores?nacionalidad=Japonés

### 7. Obtener un autor por ID (Éxito - 200)
GET {{baseUrl}}/api/autores/1

### 8. Obtener un autor inexistente (Error - 404)
GET {{baseUrl}}/api/autores/999

### 9. Editar un autor existente (Éxito - 200)
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{
  "nombre": "Antoine de Saint-Exupéry",
  "nacionalidad": "Francés",
  "biografia": "Aviador y escritor francés. Edición de prueba."
}

### 10. Eliminar un autor por ID (Éxito - 204)
DELETE {{baseUrl}}/api/autores/3